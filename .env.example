# Copy this file to .env. SQLite is used by default for the first local run.
# To use MySQL, set DB_ENGINE=mysql and fill in the connection values below.
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
